{
  "_comment": "BENCH ONLY: 24 V power supply on the DC bus, motor unloaded. Not for the battery pack. Regen is OFF because a PSU cannot absorb current. python vcu_app.py --config config_bench24v.json",

  "can": {
    "interface": "pcan",
    "channel": "PCAN_USBBUS1",
    "bitrate": 1000000
  },

  "ids": {
    "ws22_dbc_base": 128,
    "ws22_base": 1024,
    "drive_cmd_dbc_base": 1280,
    "driver_controls_base": 1280
  },

  "ws22": {
    "max_rpm_setpoint": 150,
    "max_motor_current_Arms": 80.0,
    "bus_current_limit_A": 10.0
  },

  "motor": {
    "ke_Vpk_per_rpm": null,
    "ke_learn_min_rpm": 40
  },

  "pedal": {
    "enabled": true,
    "can_id": 1536,
    "timeout_s": 0.15,
    "counter_check": true,
    "dual_channel": false,
    "ch1_mV_released": 600,
    "ch1_mV_full": 4300,
    "ch2_mV_released": 300,
    "ch2_mV_full": 2150,
    "fault_low_mV": 300,
    "fault_high_mV": 4700,
    "plausibility_pct": 10.0,
    "fault_debounce_s": 0.1,
    "deadzone_pct": 8.0,
    "full_pct": 95.0,
    "curve_exp": 1.0,
    "max_torque_pct": 20.0,
    "use_brake_switch": true,
    "rearm_travel_pct": 5.0
  },

  "limits": {
    "bus_v_trip_low": 18.0,
    "bus_v_min": 20.0,
    "bus_v_max": 26.0,
    "bus_v_trip_high": 28.0,
    "bus_v_derate_band": 2.0,

    "bus_i_max_drive_A": 5.0,
    "bus_i_trip_A": 8.0,
    "phase_i_trip_Arms": 30.0,

    "regen_max_pct": 0.0,
    "speed_mode_current_pct": 10.0,
    "current_ramp_pct_per_s": 20.0,
    "fault_ramp_pct_per_s": 100.0,

    "overspeed_trip_rpm": 200,
    "heatsink_derate_C": 65.0,
    "heatsink_trip_C": 78.0,
    "motor_derate_C": 90.0,
    "motor_trip_C": 110.0,

    "bemf_warn_ratio": 0.85,
    "bemf_cap_ratio": 0.90,
    "bemf_trip_ratio": 0.97,

    "rx_timeout_s": 0.6,
    "ignore_errors": ["ErrorReserved", "ErrorWatchdogCausedLastReset"]
  },

  "loop": {
    "control_hz": 20,
    "log_hz": 10
  },

  "sim": {
    "bus_v": 24.0,
    "source_r_ohm": 0.1,
    "sink": false
  }
}
